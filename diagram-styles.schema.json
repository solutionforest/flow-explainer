{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solutionforest.github.io/flow-explainer/diagram-styles.schema.json",
  "title": "Flow Explainer diagram styles",
  "description": "Canonical palette + material pack for Flow Explainer walkthroughs. Keys are stable ids used in Settings and in client links as &s=<key>.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "styles"],
  "properties": {
    "$schema": { "type": "string" },
    "format": {
      "const": "flow-explainer.diagram-styles",
      "description": "Format id so other tools can recognise this file."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version for the styles object (bump when fields change meaning)."
    },
    "styles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/diagramStyle" }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "description": "CSS colour: hex, rgb(a), or named (e.g. transparent)."
    },
    "diagramStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "desc", "bg", "bg2", "blocks", "neutral", "ink", "edge", "edge3d",
        "accent", "accentFg", "plate", "plateFg", "plateBd", "on", "onFg", "muted",
        "zone", "zoneBd", "chip", "labShadow", "shadow", "gridOp", "grid3", "ground",
        "mat", "rough", "opacity", "outline", "sw"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "Label in Settings." },
        "desc": { "type": "string", "description": "Short blurb under the name." },
        "dark": { "type": "boolean", "description": "Dark diagram chrome (body.d-dark)." },
        "bg": { "$ref": "#/$defs/color" },
        "bg2": { "$ref": "#/$defs/color", "description": "Secondary / vignette fill." },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/color" },
          "description": "Palette cycled for groups / ranks."
        },
        "neutral": { "$ref": "#/$defs/color" },
        "ink": { "$ref": "#/$defs/color" },
        "edge": { "$ref": "#/$defs/color", "description": "2D edge stroke." },
        "edge3d": {
          "type": ["string", "null"],
          "description": "3D edge colour; null = derive from ink."
        },
        "accent": { "$ref": "#/$defs/color" },
        "accentFg": { "$ref": "#/$defs/color" },
        "plate": { "$ref": "#/$defs/color" },
        "plateFg": { "$ref": "#/$defs/color" },
        "plateBd": { "$ref": "#/$defs/color" },
        "on": { "$ref": "#/$defs/color" },
        "onFg": { "$ref": "#/$defs/color" },
        "muted": { "$ref": "#/$defs/color" },
        "zone": { "$ref": "#/$defs/color" },
        "zoneBd": { "$ref": "#/$defs/color" },
        "chip": { "$ref": "#/$defs/color" },
        "labShadow": { "$ref": "#/$defs/color" },
        "shadow": { "$ref": "#/$defs/color" },
        "gridOp": { "type": "number", "minimum": 0, "maximum": 1 },
        "grid3": { "type": "number", "minimum": 0, "maximum": 1 },
        "ground": { "type": "number", "minimum": 0, "maximum": 1 },
        "mat": {
          "type": "string",
          "enum": ["standard", "toon", "basic", "glass"],
          "description": "3D material preset."
        },
        "rough": { "type": "number", "minimum": 0, "maximum": 1 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "outline": { "type": "number", "minimum": 0 },
        "sw": { "type": "number", "exclusiveMinimum": 0, "description": "2D stroke width." },
        "chips": { "type": "boolean", "description": "Circuit-style chip faces + pins." },
        "flat": { "type": "number", "exclusiveMinimum": 0, "description": "Block height factor." },
        "labMono": { "type": "boolean" },
        "labUpper": { "type": "boolean" }
      }
    }
  }
}
